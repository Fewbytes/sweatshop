# Kaizen station as a systemd user service. See design-docs/kaizen-agent.md
# ("Running as a service") for install steps. Edit the paths and the token
# file, then: systemctl --user enable --now sweatshop-kaizen
[Unit]
Description=sweatshop kaizen station (one small improvement per interval)
After=network-online.target

[Service]
# Station token (role kaizen) as SWEATSHOP_LINE_TOKEN=..., plus the model credential.
EnvironmentFile=%h/.sweatshop/lines/sweatshop/stations/kaizen-1/env
Environment=SWEATSHOP_LINE_URL=http://127.0.0.1:7468
ExecStart=%h/.local/bin/sweatshop line kaizen --dir %h/.sweatshop/lines/sweatshop --station kaizen-1 --interval 24h
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
