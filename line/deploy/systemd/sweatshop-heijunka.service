# Heijunka worker as a systemd user service. See design-docs/heijunka.md
# ("Running as a service") for install steps. Edit the paths and the token
# file, then: systemctl --user enable --now sweatshop-heijunka
[Unit]
Description=sweatshop heijunka worker (levels agents and WIP limit)
After=network-online.target

[Service]
# Station token (role with read access to the line) as SWEATSHOP_LINE_TOKEN=...
EnvironmentFile=%h/.sweatshop/lines/sweatshop/stations/heijunka-1/env
Environment=SWEATSHOP_LINE_URL=http://127.0.0.1:7468
ExecStart=%h/.local/bin/sweatshop line heijunka --beads %h/sweatshop --interval 5m
# SIGUSR1 pokes an immediate wake: systemctl --user kill -s USR1 sweatshop-heijunka
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
